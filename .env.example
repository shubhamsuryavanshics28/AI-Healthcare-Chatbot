# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security & JWT (Generate a strong random secret in production)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long-26p-3cse294
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, can be switched to PostgreSQL)
DATABASE_URL=sqlite:///./healthcare.db

# OpenAI Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=medical_knowledge

# Emergency Contact Configuration
EMERGENCY_HELPLINE_INDIA=112
AMBULANCE_INDIA=102
