# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Security & JWT (Generate a strong random secret in production, min 32 chars)
SECRET_KEY=generate_a_random_32_character_secret_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, can be switched to PostgreSQL)
DATABASE_URL=sqlite:///./healthcare.db

# LLM Provider Configuration ("gemini", "openai", or "fallback")
LLM_PROVIDER=gemini
REQUEST_TIMEOUT=30.0
MAX_OUTPUT_TOKENS=800
TEMPERATURE=0.4

# Google Gemini Integration (Primary - Get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI Integration (Optional secondary provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (ChromaDB) & Embedding Configuration
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=medical_knowledge_fastembed_v1
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Emergency Contact Configuration
EMERGENCY_HELPLINE_INDIA=112
AMBULANCE_INDIA=102
